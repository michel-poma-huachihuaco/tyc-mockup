# ==============================================================================
# aybar-atc - PLANTILLA DE VARIABLES DE ENTORNO
#
# Copia este fichero a .env y rellenalo:   cp .env.example .env
# El .env real NUNCA se commitea. Este .env.example SI.
#
# Solo aparecen las variables de los starters con los que se genero el servicio.
# La guia completa, con quien exige cada una y que mensaje sale si falta, esta en
# docs/VARIABLES.md.
#
# OJO: Spring Boot NO lee este fichero por si solo. Para usarlo:
#   bash        set -a; . ./.env; set +a; mvn -B spring-boot:run
#   PowerShell  Get-Content .env | Where-Object { $_ -match '^\s*[^#\s]' } |
#                 ForEach-Object { $p = $_ -split '=', 2
#                                  [Environment]::SetEnvironmentVariable($p[0].Trim(), $p[1]) }
#   Docker      docker run --env-file .env ...
#
# Antes de arrancar, comprueba que no falta nada:
#   ./comprobar-entorno.sh          (bash)
#   .\comprobar-entorno.ps1         (PowerShell)
# ==============================================================================

# ------------------------------------------------------------------------------
# Base (siempre)
# ------------------------------------------------------------------------------

# Perfil activo. NO tiene valor por defecto: sin ella el servicio arranca SIN
# perfil, que el SDK trata como entorno real (lo avisa al arrancar), y no en
# 'local'. Por eso esta copia la pone explicita. Ademas el perfil decide si las
# variables de abajo son obligatorias: en 'local' el application.yml trae valores
# por defecto, fuera de 'local' (o sin perfil) no.
# Formato: un nombre de perfil. El SDK espera local | dev | prod.
SPRING_PROFILES_ACTIVE=local

# Puerto HTTP. OPCIONAL: por defecto 8081.
# Formato: numero de 1 a 65535.
SERVER_PORT=8081


# ------------------------------------------------------------------------------
# aybar-starter-data (PostgreSQL / MongoDB)
# ------------------------------------------------------------------------------

# URI de PostgreSQL, con las credenciales dentro.
# OBLIGATORIA fuera del perfil 'local'. En 'local' no hace falta: el servicio
# levanta un H2 en memoria (aybar.data.postgres.fallback-h2).
#
# Formato: jdbc:postgresql://usuario:clave@host:puerto/base
# EL PREFIJO jdbc: ES OBLIGATORIO. Sin el, el arranque falla con
#   'url' must start with "jdbc"
# El SDK parte la URI y publica usuario y clave en spring.datasource.username /
# password, asi que la clave NO se queda dentro de spring.datasource.url.
#
# No hay PostgreSQL en el docker-compose del SDK: apunta al tuyo de desarrollo.
# AYBAR_DATASOURCE_URI=jdbc:postgresql://usuario-de-ejemplo:cambia-esta-clave@localhost:5432/aybar-atc

# URI de MongoDB. OPCIONAL: sin ella el servicio no habla con Mongo.
# Formato: mongodb://usuario:clave@host:puerto/base
#
# CUIDADO en el perfil 'local': definirla sin quitar antes las dos exclusiones de
# Mongo del application.yml tumba el arranque con
#   Included health contributor 'mongo' in group 'readiness' does not exist
# Ver docs/VARIABLES.md antes de exportarla.
# AYBAR_MONGO_URI=mongodb://usuario-de-ejemplo:cambia-esta-clave@localhost:27017/aybar-atc



# ------------------------------------------------------------------------------
# aybar-starter-messaging (Kafka)
# ------------------------------------------------------------------------------

# Broker de Kafka. OBLIGATORIA fuera del perfil 'local' (en 'local' el
# application.yml ya apunta al Kafka del docker-compose del SDK).
# Sin valor, el arranque se detiene con
#   spring.kafka.bootstrap-servers (AYBAR_KAFKA_BOOTSTRAP) es obligatorio:
#   sin este valor el arranque no puede continuar
# Vaciarla da exactamente el mismo error que no ponerla.
#
# Formato: host:puerto (o varios separados por comas).
# Valor del docker-compose del SDK:
AYBAR_KAFKA_BOOTSTRAP=localhost:9094



# ------------------------------------------------------------------------------
# aybar-starter-security (emisor OIDC / OAuth2)
# ------------------------------------------------------------------------------

# Emisor del JWT (issuer OIDC que fija el ADR del servicio).
# OBLIGATORIA fuera del perfil 'local'. Sin ella no se crea el JwtDecoder y el
# contexto no arranca:
#   Method aybarSecurityFilterChain in com.aybarsac.sdk.security.AybarSecurityAutoConfiguration
#   required a bean of type 'org.springframework.security.oauth2.jwt.JwtDecoder' that could not be found.
# El mensaje NO nombra la variable: si lo ves, es esto.
#
# En 'local' es OPCIONAL: sin ella el servicio arranca sin emisor, lo publico
# responde y lo protegido da 401 (lo que espera el login demo del front).
# Definela para validar tokens reales.
#
# Formato: URL del emisor (issuer), sin barra final.
# AYBAR_ISSUER_URI=https://<emisor-oidc-del-adr>

# Audiencia que tiene que traer el token (claim aud): la de ESTE servicio, tal
# como la emite el emisor del ADR (en Keycloak, un mapper "Audience" en el
# cliente o en un client scope). Sin ella, un token del mismo emisor emitido
# para otra aplicacion se aceptaria aqui.
# OBLIGATORIA fuera del perfil 'local': no tiene valor por defecto y, sin ella,
# ningun token se acepta. En 'local' vale el nombre del servicio, aybar-atc.
# Formato: una audiencia, o varias separadas por comas.
AYBAR_JWT_AUDIENCE=aybar-atc

# Origenes de navegador que pueden llamar a esta API (CORS). OPCIONAL: vacia o sin
# definir = CORS apagado, y un frontend servido desde otro origen no puede llamar.
# Formato: origenes exactos separados por comas, con esquema y sin ruta. Nunca "*":
# el servicio no arranca con un comodin, 'null' o un origen con ruta.
# En el perfil 'local', si application-local.yml trae su lista, manda esa.
# AYBAR_CORS_ORIGENES=http://localhost:5173,http://localhost:4200



# ------------------------------------------------------------------------------
# aybar-starter-client (HTTP entre servicios)
# ------------------------------------------------------------------------------

# Las tres de abajo son OPCIONALES y van juntas: sirven para que el servicio pida
# un token propio (client-credentials) cuando llama a otra API sin usuario detras.
# Sin ninguna, el servicio arranca igual y el interceptor sigue montado: propaga
# el correlationId y reenvia el bearer del usuario (solo a los hosts de
# AYBAR_CLIENT_HOSTS_CON_TOKEN), pero no adjunta token propio.
#
# CUIDADO: definir AYBAR_CLIENT_CLIENT_ID sin AYBAR_CLIENT_TOKEN_URI tumba el arranque:
#   aybar.client.token-uri es obligatorio para client-credentials

# Token endpoint del emisor OIDC que fija el ADR. Formato: URL completa.
# AYBAR_CLIENT_TOKEN_URI=https://<emisor-oidc-del-adr>/<token-endpoint>

# Identificador del cliente de servicio registrado en el emisor. Formato: texto.
# AYBAR_CLIENT_CLIENT_ID=

# Secreto del cliente. Formato: texto.
# En un entorno real llega por Secrets Manager, nunca por fichero.
# AYBAR_CLIENT_CLIENT_SECRET=

# Hosts a los que SI se puede adjuntar el Authorization (bearer del usuario o
# token propio). Sin ella, o vacia, el token NO se adjunta a ningun destino: las
# llamadas salen sin Authorization y la API de destino responde 401. Es lo
# seguro por defecto: el token nunca viaja a un tercero por olvido.
# Formato: lista separada por comas de hosts exactos (api.ejemplo.com) o
# sufijos con punto inicial (.ejemplo.com).
AYBAR_CLIENT_HOSTS_CON_TOKEN=localhost,.aybarsac.com



# ------------------------------------------------------------------------------
# aybar-starter-audit (auditoria Ley 29733)
# ------------------------------------------------------------------------------

# NINGUNA es obligatoria: sin destino el servicio arranca igual y la auditoria se
# escribe en el log de la aplicacion (LogPublicador). No se pierde, pero tampoco
# queda en un soporte aparte, que es lo que suele querer auditoria.
# El destino se elige por precedencia: S3 > NDJSON > log.

# Carpeta para los eventos NDJSON. Formato: ruta absoluta de un directorio.
# El directorio se crea al escribir el primer evento, no al arrancar.
AYBAR_AUDIT_NDJSON_DIR=./target/auditoria

# Bucket S3/MinIO. Gana sobre NDJSON si esta definido.
# AVISO: solo tiene efecto si el pom.xml declara software.amazon.awssdk:s3.
# El archetype NO lo declara, asi que tal cual esta, definir el bucket no hace
# nada y no se avisa por ningun sitio. Anade la dependencia antes de usarlo.
# Formato: nombre del bucket. 'aybar-auditoria' es el que crea el docker-compose del SDK.
# AYBAR_AUDIT_S3_BUCKET=aybar-auditoria

# Endpoint S3. Solo para MinIO local; en AWS se deja sin definir.
# AYBAR_AUDIT_S3_ENDPOINT=http://localhost:9000

# Credenciales de S3/MinIO. En AWS no se definen: se usa el rol de la tarea.
# Las de abajo son las del MinIO de juguete del docker-compose del SDK.
# AYBAR_AUDIT_S3_ACCESS_KEY=aybar
# AYBAR_AUDIT_S3_SECRET_KEY=cambia-esto-en-cualquier-entorno-real

