/* Opciones de TypeScript: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html */
/* Opciones del compilador de Angular: https://angular.dev/reference/configs/angular-compiler-options */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": []
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    // aybar:demo:inicio — la galería entra al programa solo por lo que importa
    // galeria.development.ts (ng serve): en producción no se compila ni pasa por los budgets.
    "src/app/demo/**",
    "src/app/galeria.development.ts",
    // aybar:demo:fin
    "src/**/*.spec.ts"
  ]
}
