# Los @aybarcorp/* NO salen de un registro: estan en paquetes/ (commiteados) y
# package.json los toma con file:, asi que npm ci no necesita credenciales.
# Esta linea existe para el caso contrario: un `npm install @aybarcorp/x` por
# nombre va a GitHub Packages, que lo rechaza sin token (falla visible), y nunca
# a npmjs.org, donde cualquiera podria publicar un @aybarcorp/x (confusion de
# dependencias). Para cambiar de version: aybar framework actualizar.
@aybarcorp:registry=https://npm.pkg.github.com
# Version exacta al instalar: dos @aybarcorp/* en versiones distintas en la misma
# pagina rompen la sesion compartida entre el anfitrion y sus remotos.
save-exact=true
