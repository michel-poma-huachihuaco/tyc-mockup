# Variables del framework Aybar. Copia este archivo a .env.local y pon los valores
# de tu entorno: .env.local no se commitea. Ninguna es un secreto (cliente público con
# PKCE), pero el emisor y la API cambian por entorno y los decide el ADR del servicio.
VITE_AYBAR_EMISOR=https://emisor.aybar.local
VITE_AYBAR_CLIENTE_ID=aybar-web
VITE_AYBAR_AUDIENCIA=aybar-api
VITE_AYBAR_API_URL=https://api.aybar.local

# Modo demo: login simulado con el Login Form de la aplicación, sin emisor ni token,
# solo con `npm run dev` y solo en localhost. Estas variables van en .env.development y
# no aquí: .env.local también entra al build de producción. Sin usuarios, se usa el emisor.
# Varios usuarios separados por «;», cada uno usuario:clave:Nombre:ROL1,ROL2 (nombre y
# roles opcionales). Si está, las cuatro sueltas de abajo no se leen.
# VITE_AYBAR_DEMO_USUARIOS=
# O uno solo:
# VITE_AYBAR_DEMO_USUARIO=
# VITE_AYBAR_DEMO_CLAVE=
# VITE_AYBAR_DEMO_NOMBRE=
# VITE_AYBAR_DEMO_ROLES=USER
